// Client-owned layout. Letter bindings use Bevy KeyCode names KeyA through KeyZ.
(
    schema_version: 1,
    slot_size_px: 52.0,
    slot_gap_px: 6.0,
    layouts: [
        (profile: "player", columns: 5),
        (profile: "enemy", columns: 4),
        (profile: "corpse", columns: 4),
        (profile: "wooden_chest", columns: 3),
        (profile: "iron_chest", columns: 8),
    ],
    bindings: (
        toggle_inventory: "KeyI",
        interact_or_collect: "KeyE",
        drop_selected: "KeyG",
    ),
    empty_rgba: (35, 49, 51, 255),
    selected_rgba: (222, 169, 91, 255),
    pending_rgba: (100, 135, 180, 255),
    busy_rgba: (180, 100, 80, 255),
)
