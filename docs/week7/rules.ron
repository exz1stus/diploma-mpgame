// Server-owned tuning. Distances use current Bevy world units.
// Do not make authority, atomicity, access checks, or replay rejection optional.
(
    schema_version: 1,
    pickup_range: 80.0,
    container_range: 100.0,
    give_range: 100.0,
    drop_distance: 36.0,
    max_health: 100,
    max_quantity_per_command: 1000,
    // Rate limit inventory requests independently of movement inputs.
    commands_per_second: 20,
    command_burst: 40,
    // Cache recent replies; a separate high-water mark rejects older replays.
    cached_results_per_session: 256,
    // A timeout requests status/resync; it never means the server rolled back.
    client_pending_timeout_ms: 5000,
)
