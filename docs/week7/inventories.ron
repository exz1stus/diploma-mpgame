        (id: "corpse", display_name: "Loot", slots: 8, access: NearbyLoot),
        (id: "wooden_chest", display_name: "Wooden chest", slots: 9, access: NearbyLoot),
        (id: "iron_chest", display_name: "Iron chest", slots: 32, access: NearbyLoot),
    ],
)
