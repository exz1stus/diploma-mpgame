// Generation settings and biome selection for craters.
// Biome names reference the single repository in ../biomes/biomes.ron.
(
    cell_size: 1024,
    min_radius: 24.0,
    max_radius: 384.0,
    density: 1.25,
    temperature_offset: 0.0,
    // First match wins: preserve polar ice, then choose climate-appropriate territory biomes.
    biome_map: [
        (biome: "polar_crater", height: (min: 0.0, max: 1.0), temperature: (min: -50.0, max: -20.0)),
        (biome: "frozen_crater_ejecta", height: (min: 0.52, max: 1.0), temperature: (min: -20.0, max: -5.0)),
        (biome: "frozen_crater", height: (min: 0.0, max: 0.52), temperature: (min: -20.0, max: -5.0)),
        (biome: "crater_ejecta", height: (min: 0.52, max: 1.0), temperature: (min: -5.0, max: 40.0)),
        (biome: "crater", height: (min: 0.0, max: 0.52), temperature: (min: -5.0, max: 40.0)),
    ],
)
