// Generation settings and biome selection for basins.
// Biome names reference the single repository in ../biomes/biomes.ron.
(
    cell_size: 6144,
    probability: 0.2,
    min_radius: 768.0,
    max_radius: 2048.0,
    min_depth: 0.07,
    max_depth: 0.16,
    min_rim_height: 0.012,
    max_rim_height: 0.026,
    smoothing: 0.9,
    temperature_offset: 0.0,
    // First match wins: preserve polar ice, then choose climate-appropriate territory biomes.
    biome_map: [
        (biome: "polar_basin", height: (min: 0.0, max: 1.0), temperature: (min: -50.0, max: -20.0)),
        (biome: "frozen_basin", height: (min: 0.0, max: 1.0), temperature: (min: -20.0, max: -5.0)),
        (biome: "basin_salt_flats", height: (min: 0.32, max: 0.44), temperature: (min: -2.0, max: 14.0)),
        (biome: "weathered_basin", height: (min: 0.0, max: 1.0), temperature: (min: 14.0, max: 40.0)),
        (biome: "basin", height: (min: 0.0, max: 1.0), temperature: (min: -5.0, max: 14.0)),
    ],
)
