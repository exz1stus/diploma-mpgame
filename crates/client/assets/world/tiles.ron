        "desert_ridge": "#EEEEEE",
        "desert_upland": "#EEEEEE",
        "frost_floor": "#EEEEEE",
        "frost_low": "#EEEEEE",
        "frost_mid": "#EEEEEE",
        "frost_ridge": "#EEEEEE",
        "frost_upland": "#EEEEEE",
        "plain_floor": "#EEEEEE",
        "plain_low": "#EEEEEE",
        "plain_mid": "#EEEEEE",
        "plain_ridge": "#EEEEEE",
        "plain_upland": "#EEEEEE",
        "snow_floor": "#EEEEEE",
        "snow_low": "#EEEEEE",
        "snow_mid": "#EEEEEE",
        "snow_ridge": "#EEEEEE",
        "snow_upland": "#EEEEEE",
        "sulfur_floor": "#EEEEEE",
        "sulfur_low": "#EEEEEE",
        "sulfur_mid": "#EEEEEE",
        "sulfur_ridge": "#EEEEEE",
        "sulfur_upland": "#EEEEEE",
    },
    layers: {
        "basalt_floor": 1,
        "basalt_low": 2,
        "basalt_mid": 3,
        "basalt_ridge": 5,
        "basalt_upland": 4,
        "desert_floor": 1,
        "desert_low": 2,
        "desert_mid": 3,
        "desert_ridge": 5,
        "desert_upland": 4,
        "frost_floor": 1,
        "frost_low": 2,
        "frost_mid": 3,
        "frost_ridge": 5,
        "frost_upland": 4,
        "plain_floor": 1,
        "plain_low": 2,
        "plain_mid": 3,
        "plain_ridge": 5,
        "plain_upland": 4,
        "snow_floor": 1,
        "snow_low": 2,
        "snow_mid": 3,
        "snow_ridge": 5,
        "snow_upland": 4,
        "sulfur_floor": 1,
        "sulfur_low": 2,
        "sulfur_mid": 3,
        "sulfur_ridge": 5,
