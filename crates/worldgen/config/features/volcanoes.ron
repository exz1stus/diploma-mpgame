// Generation settings and biome selection for volcanoes.
// Biome names reference ../biomes.ron; the map is evaluated on final height and temperature.
(
    cell_size: 4096,
    // Off in the default preset; the old preset keeps volcanoes.
    probability: 0.0,
    min_radius: 192.0,
    max_radius: 896.0,
    min_height: 0.14,
    max_height: 0.32,
    caldera_ratio: 0.28,
    caldera_depth: 0.18,
    temperature_offset: 0.0,
    biome_map: [
        (biome: "basalt_floor", height: (min: 0.0, max: 0.38), temperature: (min: -60.0, max: 60.0)),
        (biome: "basalt_low", height: (min: 0.38, max: 0.46), temperature: (min: -60.0, max: 60.0)),
        (biome: "basalt_mid", height: (min: 0.46, max: 0.54), temperature: (min: -60.0, max: 60.0)),
        (biome: "basalt_upland", height: (min: 0.54, max: 0.62), temperature: (min: -60.0, max: 60.0)),
        (biome: "basalt_ridge", height: (min: 0.62, max: 1.0), temperature: (min: -60.0, max: 60.0)),
    ],
)
