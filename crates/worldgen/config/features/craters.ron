// Generation settings and biome selection for craters.
// Biome names reference ../biomes.ron; the map is evaluated on final height and temperature.
// Crater biomes decide which objects spawn; clients draw them like the terrain biome
// underneath unless they define tiles for them.
(
    cell_size: 1024,
    min_radius: 24.0,
    max_radius: 384.0,
    density: 1.25,
    temperature_offset: 0.0,
    // First match wins: preserve polar ice, then choose climate-appropriate territory biomes.
    biome_map: [
        (biome: "polar_crater", height: (min: 0.0, max: 1.0), temperature: (min: -50.0, max: -20.0)),
        (biome: "frozen_crater_ejecta", height: (min: 0.52, max: 1.0), temperature: (min: -20.0, max: -5.0)),
        (biome: "frozen_crater", height: (min: 0.0, max: 0.52), temperature: (min: -20.0, max: -5.0)),
        (biome: "crater_ejecta", height: (min: 0.52, max: 1.0), temperature: (min: -5.0, max: 40.0)),
        (biome: "crater", height: (min: 0.0, max: 0.52), temperature: (min: -5.0, max: 40.0)),
    ],
    // Spawned only inside crater territory, in addition to the crater biomes' objects.
    // distance: from the crater centre, where 1.0 is the rim.
    objects: [
        (object: "large_rock", density: 0.006, distance: (min: 0.8, max: 1.2)),
        (object: "rock", density: 0.004, distance: (min: 0.0, max: 0.8)),
    ],
)
