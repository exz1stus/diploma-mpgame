// Terrain biome selection by final height x temperature. First matching rule wins.
// Columns are climate kinds, rows height variants (lower ground is darker in the client, so
// crater floors read as dark bowls). Feature territories use their own maps first; gaps fall
// back here. Zone limits fit the default climate (about -41 to 20 °C): snow covers the coldest
// quarter. Sulfur and basalt appear only in impact basins (features/basins.ron). The previous
// map is the `old` preset (presets/old/biome_map.ron).
[
    (biome: "snow_floor", height: (min: 0.0, max: 0.38), temperature: (min: -60.0, max: -16.0)),
    (biome: "snow_low", height: (min: 0.38, max: 0.46), temperature: (min: -60.0, max: -16.0)),
    (biome: "snow_mid", height: (min: 0.46, max: 0.54), temperature: (min: -60.0, max: -16.0)),
    (biome: "snow_upland", height: (min: 0.54, max: 0.62), temperature: (min: -60.0, max: -16.0)),
    (biome: "snow_ridge", height: (min: 0.62, max: 1.0), temperature: (min: -60.0, max: -16.0)),
    (biome: "frost_floor", height: (min: 0.0, max: 0.38), temperature: (min: -16.0, max: -6.0)),
    (biome: "frost_low", height: (min: 0.38, max: 0.46), temperature: (min: -16.0, max: -6.0)),
    (biome: "frost_mid", height: (min: 0.46, max: 0.54), temperature: (min: -16.0, max: -6.0)),
    (biome: "frost_upland", height: (min: 0.54, max: 0.62), temperature: (min: -16.0, max: -6.0)),
    (biome: "frost_ridge", height: (min: 0.62, max: 1.0), temperature: (min: -16.0, max: -6.0)),
    (biome: "plain_floor", height: (min: 0.0, max: 0.38), temperature: (min: -6.0, max: 6.0)),
    (biome: "plain_low", height: (min: 0.38, max: 0.46), temperature: (min: -6.0, max: 6.0)),
    (biome: "plain_mid", height: (min: 0.46, max: 0.54), temperature: (min: -6.0, max: 6.0)),
    (biome: "plain_upland", height: (min: 0.54, max: 0.62), temperature: (min: -6.0, max: 6.0)),
    (biome: "plain_ridge", height: (min: 0.62, max: 1.0), temperature: (min: -6.0, max: 6.0)),
    (biome: "desert_floor", height: (min: 0.0, max: 0.38), temperature: (min: 6.0, max: 60.0)),
