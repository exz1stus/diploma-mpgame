// Biome definitions. List order is the BiomeId: append new biomes to keep saved worlds valid.
//
// Each biome may spawn objects (object kinds and shared sets live in objects.ron):
//   object_sets: set names from objects.ron; omitted means `defaults.object_sets`, [] means none.
//   objects:     spawns specific to this biome.
// A spawn is (object, density, [height], [temperature], [max_height_difference]);
// density is the proposal probability per anchor tile, before footprint/overlap rejection.
// Where a biome appears is decided by biome_map.ron (terrain) and features/*.ron (feature territories).
(
    defaults: (object_sets: ["common_rocks", "pebbles"]),
    biomes: [
        (name: "permanent_polar_ice"),
        (name: "fractured_ice_basins"),
        (name: "polar_ice_highlands"),
        (name: "buried_ice_basins"),
        (name: "blue_ice_plains"),
        (name: "sintered_frost_fields"),
        (name: "glacier_ridges"),
        (name: "cold_trap_ice"),
        (name: "frosted_crater_floors"),
        (name: "ice_cemented_regolith"),
        (name: "rime_covered_ridges"),
        (name: "frozen_shadow_basins"),
        (name: "frost_margin_regolith"),
        (name: "frosted_breccia"),
        (name: "patchy_ice_highlands"),
        (name: "dark_crater_floors"),
        (name: "salt_crust_pans"),
        (name: "mixed_ice_regolith"),
        (name: "silicate_gravel_plains"),
        (name: "bright_ejecta_ridges"),
        (name: "carbonaceous_basins"),
        (name: "ochre_dust_plains", objects: [
            (object: "tree", density: 0.005, temperature: (min: 2.0, max: 20.0)),
        ]),
        (name: "weathered_basalt", object_sets: ["common_rocks", "pebbles", "iron_deposits"]),
        (name: "exposed_anorthosite"),
        (name: "dark_basalt_depressions"),
        (name: "iron_rich_regolith", object_sets: ["common_rocks", "pebbles", "iron_deposits"]),
        (name: "rocky_crater_uplands"),
        (name: "sunlit_crater_floors"),
        (name: "copper_toned_scree"),
        (name: "barren_silicate_ridges"),
        (name: "warm_exposed_rock"),
        (name: "hot_dark_regolith"),
        (name: "basin"),
        (name: "volcano"),
        (name: "crater"),
        (name: "frozen_basin"),
        (name: "frozen_volcano"),
        (name: "frozen_crater"),
        (name: "polar_crater"),
        (name: "crater_ejecta"),
        (name: "frozen_crater_ejecta"),
        (name: "polar_basin"),
        (name: "basin_salt_flats"),
        (name: "weathered_basin"),
        (name: "polar_volcano"),
        (name: "volcanic_highlands", object_sets: ["common_rocks", "pebbles", "iron_deposits"]),
        (name: "frozen_volcanic_highlands"),
    ],
)
