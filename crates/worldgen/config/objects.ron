// Object kinds and shared spawn sets.
//
// kinds: list order is the ObjectId; append new kinds to keep saved worlds valid.
//   The footprint is the occupied ground, anchored at its minimum X/Y tile.
// sets:  named spawn lists that biomes include via `object_sets` (see biomes.ron).
//   An object spawned by a set may span every biome that includes that set.
(
    kinds: [
        (name: "rock", footprint: (width: 1, height: 1)),
        (name: "large_rock", footprint: (width: 2, height: 2)),
        (name: "iron_ore", footprint: (width: 2, height: 3)),
        // Ground decoration; drawn by the client like any object.
        (name: "pebbles", footprint: (width: 1, height: 1)),
        // Rare ice crystal on the floors of cold craters (features/craters.ron).
        (name: "crystal", footprint: (width: 1, height: 1)),
    ],
    sets: {
        "common_rocks": [
            (object: "rock", density: 0.001),
            (object: "large_rock", density: 0.0005, max_height_difference: Some(0.04)),
        ],
        // Loose stones on exposed ground: none on frozen ground (below -6 °C) or high ridges.
        "pebbles": [
            (object: "pebbles", density: 0.01, height: (min: 0.0, max: 0.8), temperature: (min: -6.0, max: 1000.0)),
        ],
        // Frozen ground (snow and frost): loose stones. Crystals grow in cold craters (craters.ron).
        "polar": [
            (object: "pebbles", density: 0.01, height: (min: 0.0, max: 0.8)),
        ],
        // Sulfur basins: sulfur spikes (large_rock, drawn as spikes on sulfur), and now and then a
        // plain rock.
        "sulfur_rocks": [
            (object: "rock", density: 0.0006),
            (object: "large_rock", density: 0.002, max_height_difference: Some(0.04)),
        ],
    },
)
